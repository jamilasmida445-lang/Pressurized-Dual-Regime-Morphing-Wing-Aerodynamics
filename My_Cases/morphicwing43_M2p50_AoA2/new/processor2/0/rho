FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      rho;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -3 0 0 0 0 0];

internalField   uniform 1.225;

boundaryField
{
    inlet
    {
        type            calculated;
        value           nonuniform List<scalar> 0;
    }
    outlet
    {
        type            calculated;
        value           uniform 1.225;
    }
    bottom
    {
        type            calculated;
        value           uniform 1.225;
    }
    top
    {
        type            calculated;
        value           uniform 1.225;
    }
    left
    {
        type            empty;
    }
    right
    {
        type            empty;
    }
    airfoil
    {
        type            calculated;
        value           nonuniform List<scalar> 0;
    }
    procBoundary2to1
    {
        type            processor;
        value           uniform 1.225;
    }
}


