FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}

dimensions      [ 0 0 0 1 0 0 0 ];
internalField   uniform 288.15;

boundaryField
{
    left   { type empty; }
    right  { type empty; }
    
    inlet
    {
        type            fixedValue;
        value           uniform 288.15;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 288.15;
        value           uniform 288.15;
    }
    bottom
    {
        type            fixedValue;
        value           uniform 288.15;
    }
    top
    {
        type            fixedValue;
        value           uniform 288.15;
    }
    airfoil
    {
        type            zeroGradient;
    }
}
