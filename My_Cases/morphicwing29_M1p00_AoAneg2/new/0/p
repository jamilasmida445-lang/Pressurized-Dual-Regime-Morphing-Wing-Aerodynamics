FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}

dimensions      [ 1 -1 -2 0 0 0 0 ];
internalField   uniform 101325;

boundaryField
{
    left   { type empty; }
    right  { type empty; }
    
    inlet
    {
        type            fixedValue;
        value           uniform 101325;
    }
    outlet
    {
        type            waveTransmissive;
        field           p;
        psi             thermo:psi;     
        gamma           1.4;
        fieldInf        101325;         
        lInf            5.0;            
        value           uniform 101325;
    }
    bottom
    {
        type            fixedValue;
        value           uniform 101325;
    }
    top
    {
        type            fixedValue;
        value           uniform 101325;
    }
    airfoil
    {
        type            zeroGradient;
    }
}

