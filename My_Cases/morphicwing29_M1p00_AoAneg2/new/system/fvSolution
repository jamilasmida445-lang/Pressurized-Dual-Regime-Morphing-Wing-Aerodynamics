FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}

solvers
{
    "(rho|rhoU|rhoE)"
    {
        solver          diagonal;
    }

    "(U|e|h)"
    {
        solver          smoothSolver;
        smoother        GaussSeidel;
        nSweeps          1;
        tolerance       1e-6;
        relTol          0.01;
    }
}
