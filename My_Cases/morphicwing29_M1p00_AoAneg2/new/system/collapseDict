FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      collapseDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

collapseEdgesCoeffs
{
    minimumEdgeLength   -1;
    maximumMergeAngle   30;
}

collapseFacesCoeffs
{
    initialFaceLengthFactor -1;
}

controlMeshQualityCoeffs
{
    maxNonOrtho         70;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave          80;
    minVol              1e-13;
    minTetQuality       1e-30;
    minArea             -1;
    minDeterminant      0.001;
    minFaceWeight       0.05;
    minVolRatio         0.01;
    minTwist            0.01;
    minTriangleTwist   -1;
    minFaceFlatness     0.5;
}

