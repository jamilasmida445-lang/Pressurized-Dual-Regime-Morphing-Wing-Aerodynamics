FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "5990";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 1000;

boundaryField
{
    wing_default
    {
        type            omegaWallFunction;
        blending        binomial;
        n               2;
        value           uniform 1000;
    }
    inlet
    {
        type            turbulentMixingLengthFrequencyInlet;
        mixingLength    0.1;
        phi             phi;
        k               k;
        value           uniform 1;
    }
    outlet
    {
        type            turbulentMixingLengthFrequencyInlet;
        mixingLength    0.001;
        phi             phi;
        k               k;
        value           uniform 1;
    }
    bottom
    {
        type            turbulentMixingLengthFrequencyInlet;
        mixingLength    0.001;
        phi             phi;
        k               k;
        value           uniform 1;
    }
    top
    {
        type            turbulentMixingLengthFrequencyInlet;
        mixingLength    0.001;
        phi             phi;
        k               k;
        value           uniform 1;
    }
    left
    {
        type            empty;
    }
    right
    {
        type            empty;
    }
}


