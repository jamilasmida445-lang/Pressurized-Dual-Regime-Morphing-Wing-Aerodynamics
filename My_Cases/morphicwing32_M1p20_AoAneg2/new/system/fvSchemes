FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}

fluxScheme      Kurganov;

ddtSchemes
{
    default     Euler;
}

gradSchemes
{
    default     Gauss linear;
}

divSchemes
{
    div(((rho*nuEff)*dev2(T(grad(U))))) Gauss linear;
    div(R)      Gauss linear;
    div(tauMC)  Gauss linear;
    default     none;
}

laplacianSchemes
{
    default     Gauss linear corrected;
}

interpolationSchemes
{
    default             linear;
    reconstruct(rho)    Minmod;
    reconstruct(U)      MinmodV;
    reconstruct(T)      Minmod;
    reconstruct(e)      Minmod;
    reconstruct(p)      Minmod;
}

snGradSchemes
{
    default     corrected;
}

fluxRequired
{
    default     no;
}

wallDist
{
    method      meshWave;
    nRequired   false;
}
