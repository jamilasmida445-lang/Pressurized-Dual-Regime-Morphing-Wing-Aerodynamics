FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

application     rhoCentralFoam;

adjustTimeStep  yes;
maxCo           0.5;
maxDeltaT       5e-4;
deltaT          4e-6;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         0.9874;

writeControl    adjustableRunTime;
writeInterval   0.001;

purgeWrite      1;
writeFormat     binary;
writePrecision  6;
writeCompression off;

timeFormat      general;
timePrecision   6;

runTimeModifiable true;

minmaxAlphaCo   3.0;

functions
{
    forceCoeffs
    {
        type            forceCoeffs;
        libs            ("libforces.so");
        writeControl    timeStep;
        writeInterval   1;
        log             true;
        patches         ("wing_default");

        rho             rho;
        rhoInf          1.225;
        magUInf         272.23;
        lRef            1.0;
        Aref            0.01;

        liftDir         (-0.034899 0.999391 0.000000);
        dragDir         (0.999391 0.034899 0.000000);
        pitchAxis       (0 0 1);
        CofR            (0.25 0 0);
    }
}
