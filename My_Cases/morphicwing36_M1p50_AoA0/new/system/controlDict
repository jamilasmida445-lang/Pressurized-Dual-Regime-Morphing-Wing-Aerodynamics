FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

application     rhoCentralFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         0.08;
deltaT          4e-6;
adjustTimeStep  yes;
maxCo           0.5;
maxDeltaT       5e-6;
writeControl    runTime;
writeInterval   0.005;
purgeWrite      3;
writeFormat     binary;
writePrecision  7;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

functions
{
    forceCoeffs
    {
        type            forceCoeffs;
        libs            ("libforces.so");
        
        writeControl    runTime;
        writeInterval   0.00005;
        
        patches         (airfoil); 
        
        rho             rhoInf;
        rhoInf          1.225;
        magUInf         510.45;
        
        origin          (0 0 0);
        
        coordinateSystem
        {
            type    cartesian;
            origin  (0 0 0);
            coordinateRotation
            {
                type    axes;
                e1      (1.00000 0.00000 0);  // Drag axis
                e3      (-0.00000 1.00000 0);  // Lift axis
            }
        }
        
        lRef            1.0;
        Aref            0.01;
    }
}
