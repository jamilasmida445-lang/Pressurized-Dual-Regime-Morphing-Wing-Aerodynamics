FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      extrudeMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

constructFrom   patch;
sourceCase      ".";
sourcePatches   ( left );

exposedPatchName right;
flipNormals     false;

extrudeModel    linearNormal;

nLayers         1;
expansionRatio  1.0;

linearNormalCoeffs
{
    thickness   0.1;
}

sectorCoeffs    {};
planeCoeffs     {};

mergeFaces      false;
mergeTol        1e-6;

