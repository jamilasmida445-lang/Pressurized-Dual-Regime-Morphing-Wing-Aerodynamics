FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 101325;



// ************************************************************************* //

boundaryField
{
    wing_default
    {
        type            zeroGradient;
    }
    inlet
    {
        type            zeroGradient;
    }
    "(outlet|top|bottom)"
    {
        type            waveTransmissive;
        field           p;
        phi             phi;
        rho             rho;
        psi             thermo:psi;
        gamma           1.4;
        fieldInf        101325;
        lInf            1;
        value           uniform 101325;
    }
    "(left|right|front|back|frontAndBack)"
    {
        type            empty;
    }
}

