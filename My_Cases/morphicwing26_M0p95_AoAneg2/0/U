FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (323.0831 -11.2823 0);



// ************************************************************************* //

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (323.0807 -11.2822 0);
    }
    outlet
    {
        type            zeroGradient;
    }
    "(left|right|front|back|frontAndBack)"
    {
        type            empty;
    }
    bottom
    {
        type            inletOutlet;
        inletValue      uniform (323.0807 -11.2822 0);
        value           uniform (323.0807 -11.2822 0);
    }
    top
    {
        type            fixedValue;
        value           uniform (323.0807 -11.2822 0);
    }
    wing_default
    {
        type            noSlip;
    }
}

