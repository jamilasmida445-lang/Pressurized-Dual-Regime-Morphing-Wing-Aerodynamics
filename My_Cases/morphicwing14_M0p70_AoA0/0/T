FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];
internalField   uniform 288.15;



// ************************************************************************* //

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 288.15;
    }
    outlet
    {
        type            zeroGradient;
    }
    "(left|right|front|back|frontAndBack)"
    {
        type            empty;
    }
    bottom
    {
        type            inletOutlet;
        inletValue      uniform 288.15;
        value           uniform 288.15;
    }
    top
    {
        type            fixedValue;
        value           uniform 288.15;
    }
    wing_default
    {
        type            zeroGradient;
    }
}

