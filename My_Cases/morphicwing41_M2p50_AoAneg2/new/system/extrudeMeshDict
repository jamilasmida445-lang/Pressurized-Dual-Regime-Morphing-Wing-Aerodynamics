FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      extrudeMeshDict;
}

constructFrom patch;
sourceCase ".";
sourcePatches (left);

exposedPatchName right;    // CHANGED: Matches the existing patch in your boundary file

flipNormals false;

extrudeModel linearNormal;

nLayers 1;
expansionRatio 1.0;

linearNormalCoeffs
{
    thickness 0.01;
}

sectorCoeffs {}
mergeFaces false;