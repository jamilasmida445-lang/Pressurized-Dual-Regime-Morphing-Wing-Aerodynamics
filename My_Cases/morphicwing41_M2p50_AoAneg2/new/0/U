FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

dimensions      [ 0 1 -1 0 0 0 0 ];
internalField   uniform ( 850.22 -29.69 0 );

boundaryField
{
    left   { type empty; }
    right  { type empty; }
    
    inlet
    {
        type            fixedValue;
        value           uniform ( 850.22 -29.69 0 );
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform ( 850.22 -29.69 0 );
        value           uniform ( 850.22 -29.69 0 );
    }
    bottom
    {
        type            fixedValue;
        value           uniform ( 850.22 -29.69 0 );
    }
    top
    {
        type            fixedValue;
        value           uniform ( 850.22 -29.69 0 );
    }
    airfoil
    {
        type            noSlip;
    }
}
