{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

wallDist
{
    method          meshWave;
}

fluxScheme      Kurganov;













fluxRequired
{
    default     no;
}

wallDist
{
    method      meshWave;
    nRequired   false;
}

