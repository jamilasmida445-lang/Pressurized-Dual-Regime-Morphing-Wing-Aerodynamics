FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 288.15;

boundaryField
{
    wing_default
    {
        type            zeroGradient;
    }
    inlet
    {
        type            fixedValue;
        value           uniform 288.15;
    }
    outlet
    {
        type            zeroGradient;
    }
    bottom
    {
        type            inletOutlet;
        inletValue      nonuniform List<scalar> 0;
        value           nonuniform List<scalar> 0;
    }
    top
    {
        type            inletOutlet;
        inletValue      uniform 288.15;
        value           uniform 288.15;
    }
    left
    {
        type            empty;
    }
    right
    {
        type            empty;
    }
    procBoundary0to1
    {
        type            processor;
        value           uniform 288.15;
    }
    procBoundary0to2
    {
        type            processor;
        value           uniform 288.15;
    }
}


