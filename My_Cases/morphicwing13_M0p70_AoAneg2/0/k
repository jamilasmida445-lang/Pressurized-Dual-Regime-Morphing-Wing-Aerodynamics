FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];
internalField   uniform 0.1;



// ************************************************************************* //

boundaryField
{
    inlet          { type fixedValue; value uniform 0.1; }
    outlet         { type zeroGradient; }
    "(top|bottom)" { type inletOutlet; inletValue uniform 0.1; value uniform 0.1; }
    "(left|right|front|back|frontAndBack)" { type empty; }
    wing_default   { type kqRWallFunction; value uniform 1e-10; }
}

